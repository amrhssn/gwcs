   "source": [
    "# Create dataloaders\n",
    "batch_size = 32\n",
    "keep_ratio = 0.1\n",
    "train_loader, val_loader, test_loader = create_dataloaders(\n",
    "    train_dataset=train_dataset,\n",
    "    val_dataset=val_dataset,\n",
    "    test_dataset=test_dataset,\n",
    "    batch_size=batch_size,\n",
    "    generate_mask=True,\n",
    "    keep_ratio=keep_ratio\n",
    ")"
   ],
   "id": "732994be1b07aa59",
   "outputs": [],
   "execution_count": 7
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-10-24T00:13:51.815235Z",
     "start_time": "2025-10-24T00:13:40.883285Z"
    }
   },
   "cell_type": "code",
   "source": [
    "# inspecting the batch\n",
    "for batch_index, batch in enumerate(train_loader):\n",
    "    print(f\"Batch size: {batch.num_graphs}\")\n",
    "    print(f\"Batch x shape: {batch.x.shape}\")\n",
    "    print(f\"Batch coeffs shape: {batch.coeffs.shape}\")\n",
    "    print(f\"Number of GWT matrices: {len(batch.gwt_matrices)}\")\n",
    "    print(f\"Number of L_sym matrices: {len(batch.L_sym_matrices)}\")\n",
    "    print(f\"Number of eigenvalues:  {len(batch.eigenvalues)}\")\n",
    "    print(f\"Number of eigenvectors: {len(batch.eigenvectors)}\")\n",
    "\n",
    "    # visualizing the data\n",
    "    data_list = batch.to_data_list()\n",
    "    for data_index, data in enumerate(data_list):\n",
    "        print('=======================================')\n",
    "        print(f'=========== Sample Index: {data_index} =============')\n",
    "        print('=======================================')\n",
    "        graph_type = data.graph_metadata['graph_type']\n",
    "        G = batch.gwt_matrices[data_index]\n",
    "        # visualizing the graph signal\n",
    "        visualize_graph_signal(x=data.x,\n",
    "                               edge_index=data.edge_index,\n",
    "                               graph_type=graph_type,\n",
    "                               pos=data.graph_metadata['pos'])\n",
    "        # visualizing the clean graph signal\n",
    "        x_clean = torch.tensor(data.signal_metadata['x_clean'], dtype=torch.float32)\n",
    "        visualize_graph_signal(x=x_clean,\n",
    "                               edge_index=data.edge_index,\n",
    "                               graph_type=graph_type,\n",
    "                               pos=data.graph_metadata['pos'])\n",
    "        if graph_type == \"grid\":\n",
    "            # graph signal visualization\n",
    "            rows = data.graph_metadata['height'].item()\n",
    "            cols = data.graph_metadata['width'].item()\n",
    "            visualize_matrix(M=data.x.reshape(rows, cols),\n",
    "                             title=\"Input graph signal\",\n",
    "                             x_label=\"Cols\",\n",
    "                             y_label=\"Rows\")\n",
    "            visualize_matrix(M=x_clean.reshape(rows, cols),\n",
    "                             title=\"Clean input graph signal\",\n",
    "                             x_label=\"Cols\",\n",
    "                             y_label=\"Rows\")\n",
    "\n",
    "            # GWT coeffs visualization\n",
    "            print(\"GWT coeffs of the input graph signal:\")\n",
    "            visualize_grid_graph_sgwt_coefficients(coeffs=data.coeffs,\n",
    "                                                   num_filters=dataset.gwt_config.num_filters,\n",
    "                                                   scales=dataset.gwt_config.scales,\n",
    "                                                   rows=rows,\n",
    "                                                   cols=cols)\n",
    "            print(\"GWT coeffs of the clear graph signal:\")\n",
    "            coeffs_clean = gwt(x=x_clean, G=G)\n",
    "            coeffs_clean = reshape_coeffs_to_2d(coeffs=coeffs_clean,\n",
    "                                                num_nodes=rows*cols,\n",
    "                                                num_filters=dataset.gwt_config.num_filters)\n",
    "            visualize_grid_graph_sgwt_coefficients(coeffs=coeffs_clean,\n",
    "                                                   num_filters=dataset.gwt_config.num_filters,\n",
    "                                                   scales=dataset.gwt_config.scales,\n",
    "                                                   rows=rows,\n",
    "                                                   cols=cols)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "            # GWT sparsification mask visualization\n",
    "            print(f\"Random sparsification mask with keep_ratio {keep_ratio}:\")\n",
    "            visualize_grid_graph_sgwt_coefficients(coeffs=data.sparsification_mask,\n",
    "                                                   num_filters=dataset.gwt_config.num_filters,\n",
    "                                                   scales=dataset.gwt_config.scales,\n",
    "                                                   rows=rows,\n",
    "                                                   cols=cols)\n",
    "\n",
    "            # Pseudo-inverse GWT with all coeffs visualization\n",
    "            print(\"Pseudo-inverse GWT of all coeffs:\")\n",
    "            x_recon = igwt(coeffs=data.coeffs, G=G)\n",
    "            visualize_grid_graph_inverse_sgwt_reconstruction(x_recon=x_recon,\n",
    "                                                             x=data.x,\n",
    "                                                             rows=rows,\n",
    "                                                             cols=cols)\n",
    "\n",
    "            # Pseudo-inverse GWT with sparse coeffs visualization\n",
    "            print(f\"Pseudo-inverse GWT of sparse ({keep_ratio}) coeffs:\")\n",
    "            x_recon = igwt(coeffs=data.coeffs * data.sparsification_mask, G=G)\n",
    "            visualize_grid_graph_inverse_sgwt_reconstruction(x_recon=x_recon,\n",
    "                                                             x=data.x,\n",
    "                                                             rows=rows,\n",
    "                                                             cols=cols)\n",
    "\n",
    "        if data_index == 5:\n",
    "            break\n",
    "    break"
   ],
