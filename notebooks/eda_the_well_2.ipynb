   "source": [
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import torch\n",
    "\n",
    "from paths import ROOT_PROJECT_PATH\n",
    "from data.utils_io import load_config\n",
    "from graph_wavelet_transform.chebyshev import chebyshev_gwt_synthesis\n",
    "from visualization.graph_signal import visualize_graph_signal\n",
    "from visualization.gwt_coeffs import (\n",
    "    visualize_grid_graph_sgwt_coefficients,\n",
    "    visualize_grid_graph_inverse_sgwt_reconstruction\n",
    ")"
   ],
   "outputs": [],
   "execution_count": 47
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-25T20:06:17.669553Z",
     "start_time": "2026-01-25T20:06:17.610124Z"
    }
   },
   "cell_type": "code",
   "source": [
    "# Define the processed data directory\n",
    "processed_dir = Path(f\"{ROOT_PROJECT_PATH}/local_storage/datasets/turbulent_radiative_layer_2D/processed/20260125_214225/train\")\n",
    "\n",
    "# Load configs\n",
    "graph_config = load_config(str(processed_dir), \"graph_config.json\")\n",
    "signal_config = load_config(str(processed_dir), \"signal_config.json\")\n",
    "\n",
    "# Load Chebyshev synthesis data (for reconstruction)\n",
    "chebyshev_data = torch.load(processed_dir / \"chebyshev_synthesis_data.pt\", map_location='cpu', weights_only=False)\n"
   ],
   "id": "fba389fba0fd53e3",
   "outputs": [],
   "execution_count": 56
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-25T20:06:18.232259Z",
     "start_time": "2026-01-25T20:06:18.191096Z"
    }
   },
   "cell_type": "code",
   "source": [
    "sample_index = 90\n",
    "\n",
    "# Extract grid dimensions from config\n",
    "rows, cols = graph_config.grid_shape\n",
    "\n",
    "# Load a sample\n",
    "data = torch.load(processed_dir / f\"{sample_index}.pt\", map_location='cpu', weights_only=False)\n",
    "\n",
    "# Get scales from the sample's GWT metadata\n",
    "scales = data.gwt_metadata['scales']\n",
    "num_filters = data.gwt_metadata['num_filters']\n",
    "vis_pos = data.graph_metadata['visualization_pos']"
   ],
   "id": "d116534ce147314d",
   "outputs": [],
   "execution_count": 57
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-25T20:07:22.572743Z",
     "start_time": "2026-01-25T20:06:19.657215Z"
    }
   },
   "cell_type": "code",
   "source": [
    "# Visualize SGWT coefficients for each field\n",
    "for field_idx, field_name in enumerate(signal_config.field_names):\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"Field: {field_name}\")\n",
    "    print(f\"{'='*60}\")\n",
    "    x = data.x[:, field_idx]\n",
    "    approximate_gwt_coeffs = data.coeffs[:, field_idx, :]\n",
    "    x_reconstructed, _ = chebyshev_gwt_synthesis(\n",
    "        approximate_gwt_coeffs=approximate_gwt_coeffs,\n",
    "        chebyshev_coeffs=chebyshev_data['chebyshev_coeffs'],\n",
    "        chebyshev_eigenvalue_samples=chebyshev_data['chebyshev_eigenvalue_samples'],\n",
    "        L_sym_sparse=chebyshev_data['L_sym_sparse'],\n",
    "        lambda_min=chebyshev_data['lambda_min'],\n",
    "        lambda_max=chebyshev_data['lambda_max'],\n",
    "        chebyshev_max_degree=chebyshev_data['chebyshev_max_degree'],\n",
    "    )\n",
    "    visualize_graph_signal(\n",
    "        x=data.x[:, field_idx],\n",
    "        edge_index=data.edge_index,\n",
    "        graph_type='grid',\n",
    "        pos=vis_pos,\n",
    "    )\n",
    "    visualize_grid_graph_sgwt_coefficients(\n",
    "        coeffs=approximate_gwt_coeffs,\n",
    "        num_filters=num_filters,\n",
    "        scales=scales,\n",
    "        rows=rows,\n",
    "        cols=cols,\n",
    "    )\n",
    "    visualize_grid_graph_inverse_sgwt_reconstruction(\n",
    "        x=x,\n",
    "        x_recon=x_reconstructed,\n",
    "        rows=rows,\n",
    "        cols=cols,\n",
    "    )"
   ],
