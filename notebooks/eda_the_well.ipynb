    "# Constructing the grid graph\n",
    "import torch\n",
    "from torch_geometric.data import Data\n",
    "from torch_geometric.utils import grid, remove_self_loops\n",
    "\n",
    "# Infer grid dimensions from space_grid\n",
    "grid_height, grid_width = dataset[0]['space_grid'].shape[:2]\n",
    "print(f\"Grid dimensions: {grid_height} x {grid_width}\")\n",
    "\n",
    "# Create grid graph using PyG\n",
    "edge_index, pos = grid(height=grid_height, width=grid_width)\n",
    "edge_index, _ = remove_self_loops(edge_index)\n",
    "\n",
    "# Create node features from the space_grid (flatten the grid)\n",
    "# Each node gets the 2D coordinates as features\n",
    "node_positions = dataset[0]['space_grid'].reshape(-1, 2)  # Shape: [128*384, 2]\n",
    "node_signal = x[0, 0].reshape(-1, 1)\n",
    "node_features = torch.cat([node_signal, node_positions], dim=-1)\n",
    "\n",
    "# Create PyG Data object\n",
    "data = Data(x=node_features, edge_index=edge_index)\n",
    "\n",
    "print(f\"Number of nodes: {data.num_nodes}\")\n",
    "print(f\"Number of edges: {data.num_edges}\")\n",
    "print(f\"Node feature shape: {data.x.shape}\")\n",
    "print(f\"Edge index shape: {data.edge_index.shape}\")"
   ],
