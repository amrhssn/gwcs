   "cell_type": "code",
   "source": [
    "keep_ratio = pretraining_config.keep_ratio\n",
    "target_dataset = test_dataset\n",
    "num_samples = len(target_dataset)\n",
    "reconstruction_mode = \"monte_carlo_averaging\"  # \"monte_carlo_averaging\" or \"single_mask\"\n",
    "errors = {\n",
    "    \"single_mask\": {\n",
    "        \"igwt\": [],\n",
    "        \"igwt_clean\": [],\n",
    "        \"model\": [],\n",
    "        \"model_clean\": [],\n",
    "    },\n",
    "    \"monte_carlo_averaging\": {\n",
    "        \"igwt\": [],\n",
    "        \"igwt_clean\": [],\n",
    "        \"model\": [],\n",
    "        \"model_clean\": [],\n",
    "    }\n",
    "}\n",
    "for i in range(num_samples):\n",
    "    # if i + 1 not in [1]:\n",
    "    #     continue\n",
    "    # print(\"=\" * 80)\n",
    "    print(f\"Sample {i+1}/{num_samples}\")\n",
    "    # print(\"=\" * 80)\n",
    "    data = target_dataset[i]\n",
    "    num_nodes = data['graph_metadata']['num_nodes']\n",
    "    num_filters = dataset.gwt_config.num_filters\n",
    "    num_coeffs = num_nodes * num_filters\n",
    "    rows=data['graph_metadata']['height']\n",
    "    cols=data['graph_metadata']['width']\n",
    "    x_clean = torch.tensor(data['signal_metadata']['x_clean'], dtype=torch.float32)\n",
    "    coeffs_clean = gwt(x=x_clean, G=data.G)\n",
    "    coeffs_clean = reshape_coeffs_to_2d(coeffs=coeffs_clean,\n",
    "                                        num_nodes=rows*cols,\n",
    "                                        num_filters=dataset.gwt_config.num_filters)\n",
    "    # print(data)\n",
    "    # print(f\"num_nodes: {num_nodes}, num_filters: {num_filters}, num_coeffs: {num_coeffs}\")\n",
    "    for reconstruction_mode in [\"monte_carlo_averaging\", \"single_mask\"]:\n",
    "        if reconstruction_mode == \"monte_carlo_averaging\":\n",
    "            k = 20\n",
    "        else:\n",
    "            k = 1\n",
    "        # model reconstruction\n",
    "        x_hat, model_masks = monte_carlo_averaging_reconstruction(data=data,\n",
    "                                                                  model=model,\n",
    "                                                                  igwt_mode=\"model\",\n",
    "                                                                  keep_ratio=keep_ratio,\n",
    "                                                                  k=k,\n",
    "                                                                  mode=\"weighted_random_per_scale\",         # \"weighted_random_per_scale\" or \"random\" or \"optimized\"\n",
    "                                                                  mask_model=None)\n",
    "        sparsification_mask = model_masks[0]\n",
    "        # Pseudo-inverse GWT reconstruction\n",
    "        x_hat_igwt, igwt_masks = monte_carlo_averaging_reconstruction(data=data,\n",
    "                                                                      model=model,\n",
    "                                                                      igwt_mode=\"pseudo-inverse\",\n",
    "                                                                      keep_ratio=keep_ratio,\n",
    "                                                                      k=k,\n",
    "                                                                      mode=\"weighted_random_per_scale\",         # \"weighted_random_per_scale\" or \"random\" or \"optimized\"\n",
    "                                                                      mask_model=None)\n",
    "        # compute errors\n",
    "        error_igwt = data.x.squeeze() - x_hat_igwt.squeeze()\n",
    "        error_igwt_clean = x_clean.squeeze() - x_hat_igwt.squeeze()\n",
    "        error_model = data.x.squeeze() - x_hat.squeeze()\n",
    "        error_model_clean = x_clean.squeeze() - x_hat.squeeze()\n",
    "\n",
    "        errors[reconstruction_mode][\"igwt\"].append({\n",
    "            \"mean_abs\": error_igwt.abs().mean().item(),\n",
    "            \"mean_sq\": (error_igwt ** 2).mean().item()\n",
    "        })\n",
    "        errors[reconstruction_mode][\"igwt_clean\"].append({\n",
    "            \"mean_abs\": error_igwt_clean.abs().mean().item(),\n",
    "            \"mean_sq\": (error_igwt_clean ** 2).mean().item()\n",
    "        })\n",
    "        errors[reconstruction_mode][\"model\"].append({\n",
    "            \"mean_abs\": error_model.abs().mean().item(),\n",
    "            \"mean_sq\": (error_model ** 2).mean().item()\n",
    "        })\n",
    "        errors[reconstruction_mode][\"model_clean\"].append({\n",
    "            \"mean_abs\": error_model_clean.abs().mean().item(),\n",
    "            \"mean_sq\": (error_model_clean ** 2).mean().item()\n",
    "        })\n",
    "\n",
    "\n",
    "        print(f\"sparsification_mask.sum(): {sparsification_mask.sum()}, sparsity: {sparsification_mask.sum()/num_coeffs:.4f}\")\n",
    "        if reconstruction_mode == \"monte_carlo_averaging\":\n",
    "            # GWT coeffs visualization\n",
    "            print(\"GWT coeffs of the input graph signal:\")\n",
    "            visualize_grid_graph_sgwt_coefficients(coeffs=data.coeffs,\n",
    "                                                   num_filters=dataset.gwt_config.num_filters,\n",
    "                                                   scales=dataset.gwt_config.scales,\n",
    "                                                   rows=rows,\n",
    "                                                   cols=cols)\n",
    "            visualize_energy_distribution_across_scales(coeffs=data.coeffs)\n",
    "\n",
    "            print(\"GWT coeffs of the clear graph signal:\")\n",
    "\n",
    "            visualize_grid_graph_sgwt_coefficients(coeffs=coeffs_clean,\n",
    "                                                   num_filters=dataset.gwt_config.num_filters,\n",
    "                                                   scales=dataset.gwt_config.scales,\n",
    "                                                   rows=rows,\n",
    "                                                   cols=cols)\n",
    "            visualize_energy_distribution_across_scales(coeffs=coeffs_clean)\n",
    "\n",
    "            print(\"Random Sparsification Mask:\")\n",
    "            visualize_grid_graph_sgwt_coefficients(coeffs=sparsification_mask,\n",
    "                                                   num_filters=dataset.gwt_config.num_filters,\n",
    "                                                   scales=dataset.gwt_config.scales,\n",
    "                                                   rows=rows,\n",
    "                                                   cols=cols)\n",
    "\n",
    "            print(f\"shape: {x_hat.shape}\")\n",
    "            print(\"Neural IGWT reconstruction VS input signal:\")\n",
    "            visualize_grid_graph_inverse_sgwt_reconstruction(x_recon=x_hat,\n",
    "                                                             x=data.x,\n",
    "                                                             rows=rows,\n",
    "                                                             cols=cols,\n",
    "                                                             save_fig=False)\n",
    "            print(\"Neural IGWT reconstruction VS clean signal:\")\n",
    "            visualize_grid_graph_inverse_sgwt_reconstruction(x_recon=x_hat,\n",
    "                                                             x=x_clean,\n",
    "                                                             rows=rows,\n",
    "                                                             cols=cols,\n",
    "                                                             save_fig=False)\n",
    "\n",
    "\n",
    "\n",
    "            print(\"Pseudo-inverse IGWT reconstruction VS input signal:\")\n",
    "            visualize_grid_graph_inverse_sgwt_reconstruction(x_recon=x_hat_igwt,\n",
    "                                                             x=data.x,\n",
    "                                                             rows=rows,\n",
    "                                                             cols=cols,\n",
    "                                                             save_fig=False)\n",
    "            print(\"Pseudo-inverse IGWT reconstruction VS clean signal:\")\n",
    "            visualize_grid_graph_inverse_sgwt_reconstruction(x_recon=x_hat_igwt,\n",
    "                                                             x=x_clean,\n",
    "                                                             rows=rows,\n",
    "                                                             cols=cols,\n",
    "                                                             save_fig=False)"
   ],
